{
  "name": "blfp-client",
  "version": "2.0.0",
  "description": "BLFP - Minecraft Java 联机软件 - 客户端 (Electron + EasyTier + frpc)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/*.test.js",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.blfp.client",
    "productName": "BLFP",
    "directories": {
      "output": "build_v2.0.0"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "!**/*.map"
    ],
    "win": {
      "target": "dir",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "asar": false,
    "extraResources": [
      "bin/**"
    ]
  }
}
