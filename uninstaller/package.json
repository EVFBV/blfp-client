{
  "name": "blfp-uninstaller",
  "version": "1.0.0",
  "description": "BLFP 卸载程序",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.blfp.uninstaller",
    "productName": "BLFP-Uninstall",
    "directories": { "output": "out" },
    "files": ["main.js", "preload.js", "renderer/**"],
    "win": { "target": "portable", "artifactName": "BLFP-Uninstall.exe" },
    "asar": false
  }
}
